-- Query: eb_count_long_period_bcut (DR4 names)
-- Serves: Question C. Number of eclipsing binaries with a period over 100 days that pass the B < 13.5 cut (estimated
--   from G, BP and RP, with margins; see README.md).
-- Names: the draft DR4 data model of 26 Jun 2026. The schema name gaiadr4 is taken from that model's own example
--   query.
-- DR3 stand-in: dr3/eb_count_long_period_bcut.adql, made from this file by make_standin.py. DR3 tables:
--   gaiadr3.gaia_source, gaiadr3.vari_eclipsing_binary.
-- Last ran without error on the DR3 stand-in: 2026-10-27 (1 rows; results/run_log.tsv).
-- Last ran on DR4: never. The archive has no DR4 until 2 Dec 2026.
-- DR4 columns this query relies on:
--   gaiadr4.gaia_source: bp_rp, phot_g_mean_mag, source_id
--   gaiadr4.vari_eclipsing_binary: frequency, source_id
-- Lines tagged DR4ONLY have no DR3 equivalent and are dropped from the stand-in.
-- Cannot be tested before release: Whether DR4 G magnitudes of eclipsing binaries (which may come from the EB model)
--   behave like DR3 ones.
SELECT COUNT(*) AS n_long_period_bcut
FROM gaiadr4.vari_eclipsing_binary AS eb
LEFT OUTER JOIN gaiadr4.gaia_source AS gs
    ON gs.source_id = eb.source_id
WHERE eb.frequency < 0.01
  AND ((gs.bp_rp < 2.0 AND ((gs.phot_g_mean_mag - (-0.02704 + 0.01424*gs.bp_rp - 0.2156*gs.bp_rp*gs.bp_rp + 0.01426*gs.bp_rp*gs.bp_rp*gs.bp_rp)) + (0.85*((-0.01077 - 0.0682*gs.bp_rp - 0.2387*gs.bp_rp*gs.bp_rp + 0.02342*gs.bp_rp*gs.bp_rp*gs.bp_rp) - (-0.004288 - 0.8547*gs.bp_rp + 0.1244*gs.bp_rp*gs.bp_rp - 0.9085*gs.bp_rp*gs.bp_rp*gs.bp_rp + 0.4843*gs.bp_rp*gs.bp_rp*gs.bp_rp*gs.bp_rp - 0.06814*gs.bp_rp*gs.bp_rp*gs.bp_rp*gs.bp_rp*gs.bp_rp)))) < 13.75)
    OR (gs.bp_rp >= 2.0 AND gs.bp_rp < 2.5 AND ((gs.phot_g_mean_mag - (-0.02704 + 0.01424*gs.bp_rp - 0.2156*gs.bp_rp*gs.bp_rp + 0.01426*gs.bp_rp*gs.bp_rp*gs.bp_rp)) + (0.85*((-0.01077 - 0.0682*gs.bp_rp - 0.2387*gs.bp_rp*gs.bp_rp + 0.02342*gs.bp_rp*gs.bp_rp*gs.bp_rp) - (-0.004288 - 0.8547*gs.bp_rp + 0.1244*gs.bp_rp*gs.bp_rp - 0.9085*gs.bp_rp*gs.bp_rp*gs.bp_rp + 0.4843*gs.bp_rp*gs.bp_rp*gs.bp_rp*gs.bp_rp - 0.06814*gs.bp_rp*gs.bp_rp*gs.bp_rp*gs.bp_rp*gs.bp_rp)))) < 14.0)
    OR (gs.bp_rp >= 2.5 AND gs.phot_g_mean_mag + 2.5 < 13.5)
    OR (gs.bp_rp IS NULL AND gs.phot_g_mean_mag + (-0.3) < 13.5))
