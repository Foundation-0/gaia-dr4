-- Query: pt_summary_period (DR4 names)
-- Serves: Transit candidates per quarter-decade of period (log10 of the period in days, lower edge), with mean depth
--   and duration and the range of the number of in-transit observations.
-- Names: the draft DR4 data model of 26 Jun 2026. The schema name gaiadr4 is taken from that model's own example
--   query.
-- DR3 stand-in: dr3/pt_summary_period.adql, made from this file by make_standin.py. DR3 tables:
--   gaiadr3.vari_planetary_transit.
-- Last ran without error on the DR3 stand-in: 2026-10-27 (9 rows; results/run_log.tsv).
-- Last ran on DR4: never. The archive has no DR4 until 2 Dec 2026.
-- DR4 columns this query relies on:
--   gaiadr4.vari_planetary_transit: num_in_transit, transit_depth, transit_duration, transit_period
-- Lines tagged DR4ONLY have no DR3 equivalent and are dropped from the stand-in.
-- Cannot be tested before release: The DR4 distribution (1,007 rows).
SELECT
    t.log_period_bin,
    COUNT(*) AS n_candidates,
    AVG(t.depth_mmag) AS mean_depth_mmag,
    AVG(t.duration_days) AS mean_duration_days,
    MIN(t.n_in_transit) AS min_in_transit,
    MAX(t.n_in_transit) AS max_in_transit
FROM (
    SELECT
        FLOOR(LOG10(pt.transit_period) * 4.0) / 4.0 AS log_period_bin,
        pt.transit_depth AS depth_mmag,
        pt.transit_duration AS duration_days,
        pt.num_in_transit AS n_in_transit
    FROM gaiadr4.vari_planetary_transit AS pt
    WHERE pt.transit_period > 0.0
) AS t
GROUP BY t.log_period_bin
ORDER BY t.log_period_bin
