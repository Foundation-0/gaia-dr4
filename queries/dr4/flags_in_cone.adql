-- Query: flags_in_cone (DR4 names)
-- Serves: Question B support. Every Gaia source in a circle (a TESS aperture) with its variability flag, and its
--   eclipsing-binary and planetary-transit rows if it has them. Replace @RA@ and @DEC@ (degrees, ICRS) and
--   @RADIUS_DEG@ (degrees; one TESS pixel is 21 arcseconds, 0.00583 degrees).
-- Names: the draft DR4 data model of 26 Jun 2026. The schema name gaiadr4 is taken from that model's own example
--   query.
-- DR3 stand-in: dr3/flags_in_cone.adql, made from this file by make_standin.py. DR3 tables: gaiadr3.gaia_source,
--   gaiadr3.vari_eclipsing_binary, gaiadr3.vari_planetary_transit.
-- Last ran without error on the DR3 stand-in: 2026-10-27 (2 rows; results/run_log.tsv).
-- Last ran on DR4: never. The archive has no DR4 until 2 Dec 2026.
-- DR4 columns this query relies on:
--   gaiadr4.gaia_source: bp_rp, dec, g_photometry_origin, phot_g_mean_mag, phot_variable_flag, ra, source_id
--   gaiadr4.vari_eclipsing_binary: derived_primary_ecl_depth, frequency, model_type, source_id
--   gaiadr4.vari_planetary_transit: source_id, transit_depth, transit_period
-- Lines tagged DR4ONLY have no DR3 equivalent and are dropped from the stand-in.
-- This is a template: replace the @...@ words before running it.
-- Cannot be tested before release: The DR4 flags. DR4 also lists in_vari_eclipsing_binary and
--   in_vari_planetary_transit in vari_summary (draft), not used here.
SELECT
    gs.source_id,
    gs.ra,
    gs.dec,
    gs.phot_g_mean_mag,
    gs.bp_rp,
    gs.phot_variable_flag,
    gs.g_photometry_origin,  -- DR4ONLY
    eb.frequency AS eb_frequency,
    eb.model_type AS eb_model_type,
    eb.derived_primary_ecl_depth AS eb_primary_depth,
    pt.transit_period,
    pt.transit_depth
FROM gaiadr4.gaia_source AS gs
LEFT OUTER JOIN gaiadr4.vari_eclipsing_binary AS eb
    ON eb.source_id = gs.source_id
LEFT OUTER JOIN gaiadr4.vari_planetary_transit AS pt
    ON pt.source_id = gs.source_id
WHERE 1 = CONTAINS(POINT('ICRS', gs.ra, gs.dec), CIRCLE('ICRS', @RA@, @DEC@, @RADIUS_DEG@))
ORDER BY gs.phot_g_mean_mag
