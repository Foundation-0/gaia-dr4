-- Query: pt_candidates (DR4 names)
-- Serves: Planetary-transit candidates with what is needed to predict transit times (transit_reference_time,
--   transit_period, transit_duration, transit_depth) and gaia_source position, parallax, magnitudes and colour. No
--   TESS cross-match table exists in the archive: see pt_candidates_neighbours for the link to older Gaia IDs.
-- Names: the draft DR4 data model of 26 Jun 2026. The schema name gaiadr4 is taken from that model's own example
--   query.
-- DR3 stand-in: dr3/pt_candidates.adql, made from this file by make_standin.py. DR3 tables: gaiadr3.gaia_source,
--   gaiadr3.vari_planetary_transit.
-- Last ran without error on the DR3 stand-in: 2026-10-27 (214 rows; results/run_log.tsv).
-- Last ran on DR4: never. The archive has no DR4 until 2 Dec 2026.
-- DR4 columns this query relies on:
--   gaiadr4.gaia_source: bp_rp, dec, g_photometry_origin, parallax, parallax_error, phot_bp_mean_mag,
--   phot_g_mean_mag, phot_rp_mean_mag, phot_variable_flag, pmdec, pmra, ra, ref_epoch, ruwe, source_id, teff
--   gaiadr4.vari_planetary_transit: num_in_transit, source_id, transit_depth, transit_duration, transit_period,
--   transit_reference_time
-- Lines tagged DR4ONLY have no DR3 equivalent and are dropped from the stand-in.
-- Cannot be tested before release: All DR4 values.
SELECT
    pt.source_id,
    pt.transit_reference_time,
    pt.transit_period,
    pt.transit_duration,
    pt.transit_depth,
    pt.num_in_transit,
    gs.ra,
    gs.dec,
    gs.ref_epoch,
    gs.pmra,
    gs.pmdec,
    gs.parallax,
    gs.parallax_error,
    gs.ruwe,
    gs.phot_g_mean_mag,
    gs.phot_bp_mean_mag,
    gs.phot_rp_mean_mag,
    gs.bp_rp,
    gs.phot_variable_flag,
    gs.g_photometry_origin,  -- DR4ONLY
    gs.teff
FROM gaiadr4.vari_planetary_transit AS pt
LEFT OUTER JOIN gaiadr4.gaia_source AS gs
    ON gs.source_id = pt.source_id
ORDER BY pt.source_id
