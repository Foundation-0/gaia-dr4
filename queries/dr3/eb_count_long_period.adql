-- Query: eb_count_long_period (DR3 stand-in)
-- Serves: Question C. Number of eclipsing binaries with a period over 100 days (frequency below 0.01 per day).
-- Made from dr4/eb_count_long_period.adql by make_standin.py using column_map.tsv. Do not edit by hand.
-- DR3 tables used: gaiadr3.vari_eclipsing_binary.
-- Last ran without error: 2026-10-27, 1 rows (results/run_log.tsv).
SELECT COUNT(*) AS n_long_period
FROM gaiadr3.vari_eclipsing_binary AS eb
WHERE eb.frequency < 0.01
